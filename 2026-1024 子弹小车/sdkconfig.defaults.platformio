# 选择现有 ESP32-S3 面包板板型，与其 config.json 中的 128x32 变体一致。
CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI=y
CONFIG_OLED_SSD1306_128X32=y

# 小车软件融合：默认仅解析/记录状态，不启用未确认的硬件引脚。
CONFIG_CAR_CONTROL=y
CONFIG_CAR_AUTO_LISTEN=y
CONFIG_CAR_REPLY_AUDIO=n
CONFIG_CAR_UART_PORT=1
CONFIG_CAR_UART_TX_GPIO=-1
CONFIG_CAR_UART_RX_GPIO=-1
CONFIG_CAR_LED_GPIO=-1
CONFIG_WIFI_ACTIVATION_PORTAL=y

# 本轮文字联调：通过电脑控制台收发，关闭语音上传与小车动作输出。
CONFIG_SERIAL_TEXT_CHAT=y
